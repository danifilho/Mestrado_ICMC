#!/bin/bash --login
#SBATCH --job-name=p7ad
#SBATCH --partition=scavenger
#SBATCH --qos=scavenger
#SBATCH --account=scavenger
#SBATCH --requeue
#SBATCH --cpus-per-task=1
#SBATCH --mem=6G
#SBATCH --time=12:00:00
#SBATCH --output=resultados/logs/slurm/%x_%A_%a.out
# Extensão A–D. Executar a partir da raiz do Piloto 7. PARTE=R (extensao_AD/src/regua_ad.R) ou PY (regua_ad_py.py).
# Paralelismo: só ENTRE tarefas do array; cada tarefa usa 1 CPU e todos os algoritmos com 1 thread (num.threads/n.core/n_jobs = 1,
# OMP/BLAS = 1). Fila scavenger (não consome a cota; preempção com requeue; retomada pelo arquivo _meta já gravado).
# Uso: sbatch --array=1-N --export=ALL,RODADA=<rodada>,PARTE=<R|PY> extensao_AD/scripts/rodar_ad.sb
cd $SLURM_SUBMIT_DIR
E=/mnt/gs21/scratch/dasilvaf/conda_envs/preditores
export OMP_NUM_THREADS=1 OPENBLAS_NUM_THREADS=1 MKL_NUM_THREADS=1 P7_RAIZ=$PWD
TJ=$(sed -n "${SLURM_ARRAY_TASK_ID}p" extensao_AD/resultados/logs/tarefas/$RODADA/lista.txt)
mkdir -p extensao_AD/resultados/logs/slurm
LOG=extensao_AD/resultados/logs/slurm/$(basename $TJ .json)_${RODADA}_${PARTE}.log
if [ "$PARTE" = "R" ]; then
  PATH=$E/bin:$PATH /usr/bin/time -v Rscript extensao_AD/src/regua_ad.R $TJ >> $LOG 2>&1
else
  /usr/bin/time -v /mnt/gs21/scratch/dasilvaf/p7_pyenv/bin/python extensao_AD/src/regua_ad_py.py $TJ >> $LOG 2>&1
fi
st=$?
echo -e "$(date -Is)\t$RODADA\t$PARTE\t$TJ\t$st\t$SLURM_JOB_ID\t$SLURM_ARRAY_TASK_ID\t${SLURM_RESTART_COUNT:-0}\t$(hostname)" >> extensao_AD/resultados/logs/execucoes.tsv
exit $st
